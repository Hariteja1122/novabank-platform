{
  "info": {
    "_postman_id": "ddd639df-54fa-4c3a-b9b8-e0a100707dcf",
    "name": "NovaBank API",
    "description": "Every NovaBank endpoint through the API gateway. Works in Postman and Hoppscotch (Hoppscotch: Collections > Import > Postman collection).\n\nRun '1. Auth > Login' requests first; they store the tokens. Pick the local, dev or preprod environment for baseUrl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth and profile",
      "item": [
        {
          "name": "Login as customer (John Carter)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Stores the JWT in the collection variable `token`. Run this first.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", b.token);",
                  "pm.collectionVariables.set(\"customerId\", b.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as admin (Grace Hopper)",
