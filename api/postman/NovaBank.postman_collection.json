    {
      "name": "3. Transactions (customer)",
      "item": [
        {
          "name": "Transfer between my accounts",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/transfer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions",
                "transfer"
              ]
            },
            "description": "Pre-request script makes a fresh Idempotency-Key. Use 'Replay same transfer' to prove it is not charged twice.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccount\": \"{{fromAccount}}\",\n  \"toAccount\": \"{{toAccount}}\",\n  \"amount\": 25.0,\n  \"description\": \"Postman test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const key = pm.variables.replaceIn(\"{{$guid}}\");",
                  "pm.collectionVariables.set(\"idempotencyKey\", key);",
                  "pm.collectionVariables.set(\"lastIdempotencyKey\", key);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"reference\", pm.response.json().reference);"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay same transfer (same key, no second debit)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{lastIdempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/transfer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions",
                "transfer"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccount\": \"{{fromAccount}}\",\n  \"toAccount\": \"{{toAccount}}\",\n  \"amount\": 25.0,\n  \"description\": \"Postman test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"same reference returned\", () => pm.expect(pm.response.json().reference).to.eql(pm.collectionVariables.get(\"reference\")));"
                ]
              }
            }
          ]
        },
        {
